# Default provider shown in the sidebar: "groq" or "ollama"
LLM_PROVIDER=groq

# Groq (hosted open-weight models). Free key: https://console.groq.com/keys
GROQ_API_KEY=your_key_here
# Optional, defaults to llama-3.3-70b-versatile
GROQ_MODEL=

# Ollama (local, offline, no key needed). Install from https://ollama.com
# Optional, defaults to gemma2:9b
OLLAMA_MODEL=
# Optional, defaults to http://localhost:11434/v1
OLLAMA_BASE_URL=
